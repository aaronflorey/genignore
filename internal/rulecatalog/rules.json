{
  "$schema": "./rules.schema.json",
  "providers": [
    {
      "provider": "android",
      "match": [
        {
          "type": "file_path",
          "path": "AndroidManifest.xml"
        },
        {
          "type": "file_path",
          "path": "app/src/main/AndroidManifest.xml"
        }
      ]
    },
    {
      "provider": "angular",
      "match": [
        {
          "type": "file_path",
          "path": "angular.json"
        }
      ]
    },
    {
      "provider": "bun",
      "match": [
        {
          "type": "file_path",
          "path": "bun.lock"
        },
        {
          "type": "file_path",
          "path": "bun.lockb"
        }
      ]
    },
    {
      "provider": "cmake",
      "match": [
        {
          "type": "file_path",
          "path": "CMakeLists.txt"
        }
      ]
    },
    {
      "provider": "composer",
      "match": [
        {
          "type": "file_path",
          "path": "composer.json"
        }
      ]
    },
    {
      "provider": "dart",
      "match": [
        {
          "type": "file_path",
          "path": "pubspec.yaml"
        }
      ]
    },
    {
      "provider": "deno",
      "match": [
        {
          "type": "file_path",
          "path": "deno.json"
        },
        {
          "type": "file_path",
          "path": "deno.jsonc"
        }
      ]
    },
    {
      "provider": "go",
      "match": [
        {
          "type": "file_path",
          "path": "go.mod"
        }
      ]
    },
    {
      "provider": "godot",
      "match": [
        {
          "type": "file_path",
          "path": "project.godot"
        }
      ]
    },
    {
      "provider": "gradle",
      "match": [
        {
          "type": "file_path",
          "path": "build.gradle"
        },
        {
          "type": "file_path",
          "path": "build.gradle.kts"
        },
        {
          "type": "file_path",
          "path": "settings.gradle"
        },
        {
          "type": "file_path",
          "path": "settings.gradle.kts"
        }
      ]
    },
    {
      "provider": "java",
      "match": [
        {
          "type": "file_path",
          "path": "build.gradle"
        },
        {
          "type": "file_path",
          "path": "build.gradle.kts"
        },
        {
          "type": "file_path",
          "path": "pom.xml"
        }
      ]
    },
    {
      "provider": "jekyll",
      "match": [
        {
          "type": "file_path",
          "path": "_config.yml"
        }
      ]
    },
    {
      "provider": "jetbrains",
      "match": [
        {
          "type": "file_path",
          "path": ".idea"
        },
        {
          "type": "file_path",
          "path": "*.iml"
        }
      ]
    },
    {
      "provider": "laravel",
      "match": [
        {
          "type": "file_path",
          "path": "artisan"
        },
        {
          "type": "file_content_line",
          "path": "composer.json",
          "contains": "laravel/framework"
        }
      ]
    },
    {
      "provider": "maven",
      "match": [
        {
          "type": "file_path",
          "path": "pom.xml"
        }
      ]
    },
    {
      "provider": "nextjs",
      "match": [
        {
          "type": "file_path",
          "path": "next.config.js"
        },
        {
          "type": "file_path",
          "path": "next.config.mjs"
        },
        {
          "type": "file_path",
          "path": "next.config.ts"
        }
      ]
    },
    {
      "provider": "node",
      "match": [
        {
          "type": "file_path",
          "path": "package.json"
        },
        {
          "type": "file_path",
          "path": "bun.lock"
        },
        {
          "type": "file_path",
          "path": "bun.lockb"
        }
      ]
    },
    {
      "provider": "nestjs",
      "match": [
        {
          "type": "file_path",
          "path": "nest-cli.json"
        }
      ]
    },
    {
      "provider": "python",
      "match": [
        {
          "type": "file_path",
          "path": "pyproject.toml"
        },
        {
          "type": "file_path",
          "path": "requirements.txt"
        },
        {
          "type": "file_path",
          "path": "setup.py"
        }
      ]
    },
    {
      "provider": "rails",
      "match": [
        {
          "type": "file_path",
          "path": "bin/rails"
        },
        {
          "type": "file_path",
          "path": "config/application.rb"
        }
      ]
    },
    {
      "provider": "ruby",
      "match": [
        {
          "type": "file_path",
          "path": "Gemfile"
        }
      ]
    },
    {
      "provider": "rust",
      "match": [
        {
          "type": "file_path",
          "path": "Cargo.toml"
        }
      ]
    },
    {
      "provider": "symfony",
      "match": [
        {
          "type": "file_path",
          "path": "bin/console"
        },
        {
          "type": "file_path",
          "path": "config/bundles.php"
        },
        {
          "type": "file_path",
          "path": "symfony.lock"
        }
      ]
    },
    {
      "provider": "swift",
      "match": [
        {
          "type": "file_path",
          "path": "*.swift"
        },
        {
          "type": "file_path",
          "path": "Package.swift"
        }
      ]
    },
    {
      "provider": "terraform",
      "match": [
        {
          "type": "file_path",
          "path": "*.tf"
        },
        {
          "type": "file_path",
          "path": "*.tfvars"
        },
        {
          "type": "file_path",
          "path": ".terraform.lock.hcl"
        }
      ]
    },
    {
      "provider": "unity",
      "match": [
        {
          "type": "file_path",
          "path": "ProjectSettings/ProjectVersion.txt"
        }
      ]
    },
    {
      "provider": "visualstudiocode",
      "match": [
        {
          "type": "file_path",
          "path": ".vscode"
        },
        {
          "type": "file_path",
          "path": "*.code-workspace"
        }
      ]
    }
  ]
}
